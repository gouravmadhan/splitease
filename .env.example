# MongoDB Atlas connection string (Atlas > Connect > Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/splitease?retryWrites=true&w=majority
# OPTIONAL passcode. Leave empty (or delete the line) for NO password protection, which is the default.
# You can also turn protection on or off later from the app: Settings > Passcode protection.
# If you set it here it wins over the in-app setting and can only be changed here.
APP_PASSCODE=
# Database name. Defaults to "splitease" even if the URI has no database in it.
MONGODB_DB=splitease
